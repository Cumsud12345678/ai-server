GEMINI_API_KEY=buraya_açarını_yaz
# GEMINI_MODELS=gemini-3.5-flash,gemini-3-flash-preview
PORT=3000

# --- İNKİŞAF: saxta müştəri API-si (npm run mock) ---
ALLOW_LOCAL_CONNECTORS=1
DEMO_CUSTOMER_KEY=demo-customer-secret

# --- "own-site" müştərisi (öz real DB-n, yalnız oxuma) ---
# MONGODB_URI=mongodb://oxuma_user:parol@host:27017/DB_ADI
# NAME_FIELD=label
# LISTING_URL_TEMPLATE=https://saytin.az/elanlar/{make}-{model}-{id}
# IMAGE_BASE_URL=https://saytin.az
# ACTIVE_STATUS=active
# COL_LISTINGS=listings  (və COL_MAKES, COL_MODELS, COL_CATEGORIES, COL_CITIES, COL_FUELTYPES, COL_TRANSMISSIONS)

# --- Debug ---
# DEBUG_SEARCH=1
# --- Production: NODE_ENV=production olanda devOnly müştərilər yüklənmir ---

# --- Portal backend-i ilə əlaqə (production-da mütləq dəyişdir) ---
# Portal backend-i /v1/service/* endpoint-lərini bu tokenlə çağırır (uzun, təsadüfi dəyər).
# Köhnə adı ONBOARDING_ADMIN_TOKEN də işləyir.
SERVICE_TOKEN=buraya_uzun_tesadufi_token
# 64 hex simvol: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TENANT_SECRET_ENCRYPTION_KEY=buraya_64_hex_simvolluq_acar
# Yeni müştərilər üçün defolt limitlər
# DEFAULT_MONTHLY_REQUESTS=500
# DEFAULT_RATE_PER_MINUTE=20
# --- Müştərilər və istifadə sayğacı ---
# MongoDB (production üçün): müştərilər "tenants", sayğac "usage" kolleksiyasında saxlanır.
# Bu, elanların oxunduğu MONGODB_URI-dən AYRIDIR. Atlas-da ayrı baza və ya portalın bazası ola bilər.
# AI_MONGODB_URI=mongodb+srv://istifadeci:parol@cluster.mongodb.net/
# AI_MONGODB_DB=car_advisor_ai
# AI_MONGODB_URI verilməyibsə, aşağıdakı fayllar istifadə olunur (yalnız inkişaf üçün; hostinqdə disk silinə bilər):
CUSTOMER_TENANTS_FILE=./data/customer-tenants.json
# USAGE_FILE=./data/usage.json

# --- Token qənaəti (hamısı ixtiyaridir) ---
# Eyni sualın cavabı bu qədər saniyə keşdən verilir (0 = söndür)
ANSWER_CACHE_SECONDS=300
# Gemini-yə göndərilən söhbət tarixçəsi: son N mesaj, hər biri ən çox N simvol
HISTORY_TURNS=6
HISTORY_CHARS=700
# Cavabın maksimum uzunluğu (token). Gemini-də "düşünmə" tokenləri də daxildir: 2000-dən az qoysan cavab yarımçıq kəsilə bilər.
# Defolt: limitsiz
# MAX_OUTPUT_TOKENS=3000
# Təlimata düz yazılan siyahının maksimum ölçüsü (böyük siyahılar server tərəfdə çevrilir)
VOCAB_INLINE_MAX=60
# Gemini "düşünmə" tokenləri limiti (0 = söndür; yalnız dəstəkləyən modellərdə, əvvəlcə sına)
# GEMINI_THINKING_BUDGET=0

# --- Bilik bazası / dəstək botu (hamısı ixtiyaridir, defolt dəyərlər yazılıb) ---
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_EMBED_DIM=768
# KB_MAX_SOURCES=30          # müştəri başına mənbə sayı
# KB_MAX_CHUNKS=2500         # müştəri başına mətn hissəsi (≈ 2 milyon simvol)
# KB_MAX_FILE_BYTES=6291456  # bir fayl (6 MB); panel proksisi 10 MB gövdədə kəsir
# KB_MAX_PAGES=40            # "bütün saytı oxu"da maksimum səhifə
# KB_MIN_COSINE=0.55         # bundan aşağı oxşarlıqda "bilmirəm" (Gemini çağırılmır)

# ---- Balans və qiymətləndirmə ----
# Müştəriyə yazılan məbləğ = həqiqi Gemini xərci (USD) × USD_AZN_RATE × BILLING_MARKUP. Hər müştəri üçün admin vuruğu fərdi dəyişə bilər.
# BILLING_MARKUP=1.5
# USD_AZN_RATE=1.7
# Pulsuz məbləğ (müştəriyə yazılan manatla) və müddəti: monthly (hər ay yenilənir, yığılmır) | once (yalnız qeydiyyatda)
# BILLING_FREE_AZN=2
# BILLING_FREE_PERIOD=monthly
# Qalıq bu həddən azalanda "balans azalır" xəbərdarlığı (AZN)
# BILLING_LOW_AZN=1
# Yükləmə sorğusunun minimum və maksimum məbləği (AZN)
# BILLING_MIN_TOPUP_AZN=10
# BILLING_MAX_TOPUP_AZN=1000
# false: xərci hesablayır, amma balans bitəndə HEÇ VAXT dayandırmır (keçid dövrü üçün)
# BILLING_ENFORCE=true
# Ödəniş provayderi: manual (admin əl ilə təsdiq edir) və ya qeydiyyatdan keçmiş ad (src/billing/providers.js)
# BILLING_PROVIDER=manual
# Müştəriyə "yüklə" düyməsindən sonra göstərilən təlimat (kart nömrəsi, köçürmə qeydi və s.)
# BILLING_MANUAL_INSTRUCTIONS=
# Gemini qiymətləri (1M token üçün USD): defoltlar yayımlanmış qiymətlərə görə təxminidir, Google dəyişsə yenilə
# GEMINI_PRICES={"gemini-3.5-flash":{"in":1.5,"out":9,"cachedIn":0.15},"gemini-3-flash-preview":{"in":0.5,"out":3,"cachedIn":0.05}}
# Fayl rejimində (AI_MONGODB_URI yoxdur) balans bu fayla yazılır; production-da MongoDB istifadə et
# BILLING_FILE=
